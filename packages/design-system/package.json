{
  "name": "@vigil/design-system",
  "version": "1.0.0",
  "private": true,
  "description": "Tokens, Feather icon badges, Framer Motion + View Transition primitives.",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
