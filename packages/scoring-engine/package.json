{
  "name": "@vigil/scoring-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Pure, framework-agnostic 5-signal distress scoring. Runs identically on-device and server-side.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
