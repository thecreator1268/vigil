    "html2canvas": "^1.4.1",
    "i18next": "^26.4.2",
    "jspdf": "^4.2.1",
    "lottie-react": "^3.1.2",
    "meyda": "^5.6.3",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
